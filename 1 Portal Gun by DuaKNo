startGrab = function(fromCenter)
	local char = lp.Character
	local head = char and char:FindFirstChild("Head")
	local cam = C()
	local function centerHit(extra)
		if not cam then return nil end
		local vp = cam.ViewportSize
		local ray = cam:ViewportPointToRay(vp.X / 2, vp.Y / 2)
		local ign = { char, fxFolder }
		if extra then ign[#ign + 1] = extra end
		return castRay(ray.Origin, ray.Direction * 600, ign)
	end
	local target, hitPos
	if fromCenter then
		local r = centerHit()
		target = r and r.Instance
		hitPos = r and r.Position
	else
		target = mouse.Target
		hitPos = mouse.Hit.Position
	end
	if not (head and target) or target.Anchored or isCharacterPart(target) then return end
	if (hitPos - head.Position).Magnitude >= 10 then return end
	holding = true
	if gun then gun.grav:Play() end
	ggVisible(true)

	local ball = Instance.new("Part")
	ball.Name = "DragBall"
	ball.Transparency = 1
	ball.CanCollide = false
	ball.Size = Vector3.new(.2, .2, .2)
	ball.Shape = Enum.PartType.Ball
	ball.CFrame = CFrame.new(hitPos)
	ball.Parent = workspace
	dragger = ball
	mouse.TargetFilter = target
	setGrabTitle()

	local weld = Instance.new("ManualWeld", ball)
	weld.C0 = ball.CFrame:Inverse() * target.CFrame
	weld.Part0 = ball
	weld.Part1 = target

	local mover = Instance.new("BodyPosition")
	mover.Name = "Mover"
	mover.MaxForce = Vector3.new(40000, 40000, 40000)
	mover.P = 40000
	mover.D = 1000
	mover.Position = ball.Position
	mover.Parent = ball
	local rot = Instance.new("BodyGyro")
	rot.Name = "RotMover"
	rot.MaxTorque = Vector3.new(3000, 3000, 3000)
	rot.P = 3000
	rot.D = 500
	rot.CFrame = C().CFrame
	rot.Parent = ball

	hud()
	task.spawn(function()
		while dragger == ball and ball.Parent do
			local h = lp.Character and lp.Character:FindFirstChild("Head")
			if not h then break end
			local aim = mouse.Hit.Position
			if fromCenter then
				local r = centerHit(target)
				local cl = cam and cam.CFrame
				aim = r and r.Position or (cl and cl.Position + cl.LookVector * 100) or aim
			end
			local cf = CFrame.new(h.Position, aim)
			mover.Position = (cf + cf.LookVector * 10).Position
			rot.CFrame = C().CFrame
			task.wait()
		end
		if dragger == ball then releaseGrab() end
	end)
end

