end

local function removePortal(key)
	local P = portals[key]
	if not P then return end
	portals[key] = nil
	if exitP == P then exitP = nil end
	P.part:Destroy()
end

local function clearPortals()
	removePortal("blue")
	removePortal("yellow")
	resetGunColors()
	relink()
end

local function ripple(P)
	if not (P and P.part and P.part.Parent) then return end
	local up = TweenService:Create(P.part, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = P.size * 1.15 })
	up:Play()
	up.Completed:Connect(function()
		if P.part.Parent then
			TweenService:Create(P.part, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = P.size }):Play()
		end
	end)
end

