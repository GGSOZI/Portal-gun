local function castRay(origin, dir, filter)
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl.Character then filter[#filter + 1] = pl.Character end
	end
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.IgnoreWater = true
	rp.FilterDescendantsInstances = filter
	for _ = 1, 20 do
		local hit = workspace:Raycast(origin, dir, rp)
		if not hit then return nil end
		local inst = hit.Instance
		local isTerrain = inst:IsA("Terrain")
		local root = (not isTerrain) and inst.AssemblyRootPart or nil
		local moving = (not isTerrain) and not inst.Anchored and not (root and root.Anchored)
		if moving or (not inst.CanCollide and not isTerrain) then
			filter[#filter + 1] = inst
			rp.FilterDescendantsInstances = filter
		else
			return hit
		end
	end
	return nil
end

local function overlapsPortal(o, hit)
	local ocf = o.part.CFrame
	local n = hit.Normal
	local pos = hit.Position
	if math.abs(n.Y) < 0.9 and ocf.LookVector:Dot(n) > 0.9 and math.abs(ocf.LookVector:Dot(pos - ocf.Position)) < 0.6 then
		local lc = ocf:PointToObjectSpace(pos)
		local nx, ny = lc.X / (PW + 0.4), lc.Y / (PH + 0.4)
		return nx * nx + ny * ny < 1
	end
	return (o.part.Position - pos).Magnitude < ((math.abs(n.Y) >= 0.9) and 6 or 5.5)
end

local projectiles = {}

local function fireProjectile(key, from, hit)
	local col = COLORS[key]
	local goal = hit.Position + hit.Normal * 0.06
	local dur = math.clamp((goal - from).Magnitude / PROJ_SPEED, 0.04, 1.6)

	local part = Instance.new("Part")
	part.Name = "PortalShot_" .. key
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.new(0.4, 0.4, 0.4)
	part.Position = from
	part.Parent = fxFolder

	local emitters = {}
	local function emitter(cfg)
		local e = Instance.new("ParticleEmitter")
		for k, v in pairs(cfg) do pcall(function() e[k] = v end) end
		pcall(function() e.LockedToPart = false end)
		pcall(function() e.LightInfluence = 0 end)
		e.Parent = part
		emitters[#emitters + 1] = e
	end
	emitter({
		Texture = "http://www.roblox.com/asset/?id=5192965045",
		Rate = 120, Lifetime = NumberRange.new(0.2, 0.32), Speed = NumberRange.new(0, 0),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.8), NumberSequenceKeypoint.new(1, 0) }),
		Color = ColorSequence.new(col.edge, col.main), Transparency = NumberSequence.new(0, 1),
		LightEmission = 1, Brightness = 4, ZOffset = 1, Rotation = NumberRange.new(0, 360),
	})
	emitter({
		Rate = 70, Lifetime = NumberRange.new(0.25, 0.5), Speed = NumberRange.new(2, 9),
		SpreadAngle = Vector2.new(180, 180),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) }),
		Color = ColorSequence.new(Color3.new(1, 1, 1), col.edge), Transparency = NumberSequence.new(0, 1),
		LightEmission = 1,
	})
	local light = Instance.new("PointLight")
	light.Color = col.main
	light.Range = 10
	light.Brightness = 3
	light.Parent = part

	playSound(col.shoot, 1, 0.5)
	projectiles[#projectiles + 1] = {
		part = part, from = from, goal = goal, dur = dur, t = 0,
		land = function()
			for _, e in ipairs(emitters) do pcall(function() e.Enabled = false end) end
			light:Destroy()
			Debris:AddItem(part, 0.8)
			local o = otherOf(key)
			if not (o and overlapsPortal(o, hit)) then newPortal(key, hit) end
		end,
	}
end

track(RunService.Heartbeat:Connect(function(dt)
	for i = #projectiles, 1, -1 do
		local pr = projectiles[i]
		pr.t += dt
		local a = math.min(pr.t / pr.dur, 1)
		if pr.part.Parent then pr.part.Position = pr.from:Lerp(pr.goal, a) end
		if a >= 1 then
			table.remove(projectiles, i)
			pr.land()
		end
	end
end))

local function shoot(key, screenPos)
	if not equipped or holding or os.clock() - lastShot < 0.25 then return end
	local char = lp.Character
	if not char then return end
	lastShot = os.clock()
	local cam = C()
	screenPos = screenPos or cam.ViewportSize / 2
	local ray = cam:ViewportPointToRay(screenPos.X, screenPos.Y)
	local hit = castRay(ray.Origin, ray.Direction * 600, { char, fxFolder })

	local bad, onPortal = not hit, false
	if hit then
		local head = char:FindFirstChild("Head")
		if head and (hit.Position - head.Position).Magnitude < 2 then bad = true end
		if isCharacterPart(hit.Instance) then bad = true end
		local o = otherOf(key)
		if o and overlapsPortal(o, hit) then
			bad = true
			onPortal = true
		end
	end
	if bad then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local from
	if gun and gun.cyl1 and gun.cyl1.Parent then
		from = (gun.cyl1.CFrame * CFrame.new(0, 0, -2.7)).Position
	else
		from = (hrp and hrp.Position or cam.CFrame.Position) + cam.CFrame.LookVector * 1.5
	end
	fireProjectile(key, from, hit)
	if gun and gun.cyl1 and gun.cyl1.Parent then
		gun.cyl1.BrickColor = BrickColor.new(COLORS[key].brick)
		gun.cyl1.Material = Enum.Material.Neon
		gun.cyl2.BrickColor = BrickColor.new(COLORS[key].brick)
	end
end

local r6 = {}
local function armPitch()
	return math.clamp(math.asin(math.clamp(C().CFrame.LookVector.Y, -1, 1)), -1.3, 1.3)
end
local function armR6()
	local char = lp.Character
	local torso = char and char:FindFirstChild("Torso")
	local rs = torso and torso:FindFirstChild("Right Shoulder")
	local ls = torso and torso:FindFirstChild("Left Shoulder")
	local nk = torso and torso:FindFirstChild("Neck")
	if not (rs and ls and nk) then return end
	if r6.rs ~= rs then r6 = { rs = rs, ls = ls, nk = nk, rs0 = rs.C0, ls0 = ls.C0, nk0 = nk.C0 } end
	if equipped then
		local p = armPitch()
		rs.C0 = rs.C0:Lerp(CFrame.new(1, .65, 0) * CFrame.Angles(p, 1.55, 0), 0.1)
		ls.C0 = ls.C0:Lerp(CFrame.new(-1, .65, 0) * CFrame.Angles(p, -1.55, 0), 0.1)
		nk.C0 = nk.C0:Lerp(CFrame.new(0, 1, 0) * CFrame.Angles(p + 1.55, 3.15, 0), 0.2)
	else
		rs.C0 = rs.C0:Lerp(r6.rs0, 0.1)
		ls.C0 = ls.C0:Lerp(r6.ls0, 0.1)
		nk.C0 = nk.C0:Lerp(r6.nk0, 0.2)
	end
end
local function armR15()
	if not equipped then return end
	local char = lp.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local ua = char and char:FindFirstChild("RightUpperArm")
	local rsh = ua and ua:FindFirstChild("RightShoulder")
	if not (hrp and rsh) then return end
	local rootCFrame = hrp.CFrame
	local rotationOffset = (rootCFrame - rootCFrame.Position):Inverse()
	rsh.Transform = rotationOffset * CFrame.new(Vector3.zero, C().CFrame.LookVector * 5000) * CFrame.Angles(math.pi / 2, 0, 0)
end
local function armUpdate(stepped)
	local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	if hum.RigType == Enum.HumanoidRigType.R15 then
		if stepped then armR15() end
	elseif not stepped then
		armR6()
	end
end
track(RunService.Stepped:Connect(function() pcall(armUpdate, true) end))
track(RunService.RenderStepped:Connect(function() pcall(armUpdate, false) end))

local fallRP = RaycastParams.new()
fallRP.FilterType = Enum.RaycastFilterType.Exclude

local function softLanding(hrp)
	if not ANTI_FALL then return end
	local v = hrp.AssemblyLinearVelocity
	if v.Y > -FALL_SAFE then return end
	fallRP.FilterDescendantsInstances = { lp.Character, fxFolder }
	if not workspace:Raycast(hrp.Position, Vector3.new(0, -14, 0), fallRP) then return end
	for _, P in pairs(portals) do
		local pcf = P.part.CFrame
		if pcf.LookVector.Y > 0.7 then
			local lc = pcf:PointToObjectSpace(hrp.Position)
			if math.abs(lc.X) < PW / 2 + 0.8 and math.abs(lc.Y) < PH / 2 + 0.8 and lc.Z < 0 then return end
		end
	end
	hrp.AssemblyLinearVelocity = Vector3.new(v.X, -FALL_SAFE, v.Z)
end

local function teleport(P, Q, hrp)
	local pcf, qcf = P.part.CFrame, Q.part.CFrame
	local lcf = pcf:ToObjectSpace(hrp.CFrame)
	local qn = qcf.LookVector
	local qVert = math.abs(qn.Y) > 0.7
	local push = qVert and 3.4 or 2.6
	local ly = lcf.Position.Y
	if not qVert then ly = math.clamp(ly, -2, 2) end
	local newCF = qcf * ROT * CFrame.new(lcf.Position.X, ly, push) * (lcf - lcf.Position)

	local look = newCF.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.2 then
		local ol = hrp.CFrame.LookVector
		flat = Vector3.new(ol.X, 0, ol.Z)
	end
	if flat.Magnitude < 0.05 then flat = Vector3.new(0, 0, -1) end
	local pos = newCF.Position

	if qn.Y > -0.7 then
		local rp = RaycastParams.new()
		rp.FilterType = Enum.RaycastFilterType.Exclude
		rp.FilterDescendantsInstances = { lp.Character, fxFolder }
		local g = workspace:Raycast(pos + Vector3.new(0, 2, 0), Vector3.new(0, -10, 0), rp)
		if g and pos.Y - 3 < g.Position.Y then pos = Vector3.new(pos.X, g.Position.Y + 3, pos.Z) end
	end

	if os.clock() - lastTP < MOMENTUM_WINDOW then
		boost = math.min(boost + MOMENTUM_GAIN, MOMENTUM_MAX)
	else
		boost = 1
	end

	local v = hrp.AssemblyLinearVelocity
	local nv = qcf:VectorToWorldSpace(ROT:VectorToWorldSpace(pcf:VectorToObjectSpace(v)))
	local out = nv:Dot(qn)
	local pVert = math.abs(pcf.LookVector.Y) > 0.7
	if qVert then
		local speed = math.clamp(math.max(out, MIN_OUT_VERT) * boost, 0, MAX_SPEED)
		local lateral = pVert and Vector3.new(v.X, 0, v.Z) or (nv - qn * out)
		nv = lateral + qn * speed
	else
		if out < MIN_OUT_WALL then nv = nv + qn * (MIN_OUT_WALL - out) end
		nv = nv * boost
	end
	if nv.Magnitude > MAX_SPEED then nv = nv.Unit * MAX_SPEED end

	hrp.CFrame = CFrame.lookAt(pos, pos + flat.Unit)
	hrp.AssemblyLinearVelocity = nv
	hrp.AssemblyAngularVelocity = Vector3.zero

	playEnter(Q.key)
	ripple(P)
	ripple(Q)
end

track(RunService.Heartbeat:Connect(function()

	local char = lp.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hrp then pcall(softLanding, hrp) end
	local b, y = portals.blue, portals.yellow
	if not (hrp and hum and b and y) then exitP = nil return end

	if exitP then
		local lc = exitP.part.CFrame:PointToObjectSpace(hrp.Position)
		local vertical = math.abs(exitP.part.CFrame.LookVector.Y) > 0.7
		if math.abs(lc.X) > PW / 2 + 0.5 or math.abs(lc.Y) > PH / 2 + 0.5
			or -lc.Z > (vertical and 5 or 3.2) or lc.Z > 1 then
			exitP = nil
		end
	end

	if os.clock() - lastTP < 0.4 then return end
	for _, pair in ipairs({ { b, y }, { y, b } }) do
		local P, Q = pair[1], pair[2]
		if P ~= exitP then
			local pcf = P.part.CFrame
			local lc = pcf:PointToObjectSpace(hrp.Position)
			local d = -lc.Z
			if math.abs(lc.X) < PW / 2 and math.abs(lc.Y) < PH / 2 and d > -0.3 then
				local n = pcf.LookVector
				local vn = hrp.AssemblyLinearVelocity:Dot(n)
				local trig
				if n.Y > 0.7 then
					trig = d < 3.6
				elseif n.Y < -0.7 then
					trig = d < 3.6 and vn < -2
				else
					trig = d < 2.4 and (vn < -2 or hum.MoveDirection:Dot(n) < -0.25)
				end
				if trig then
					teleport(P, Q, hrp)
					lastTP = os.clock()
					exitP = Q
					return
				end
			end
		end
	end
end))

