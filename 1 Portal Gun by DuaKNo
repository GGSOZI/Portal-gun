local buttonConns = {}
local SLOT_OF = { [ACT_YELLOW] = "yellow", [ACT_BLUE] = "blue", [ACT_REMOVE] = "remove", [ACT_FLASH] = "flash", [ACT_GRAB] = "grab" }

local function buttonSize(vp)
	return math.clamp(math.floor(math.min(vp.X, vp.Y) * 0.13), 50, 80)
end

local function slotCenter(slot, S, vp)
	local gap = math.max(6, math.floor(S * 0.12))
	local margin = math.max(8, math.floor(S * 0.2))
	local jumpZone = math.max(110, vp.Y * 0.32)
	local rowY = vp.Y - jumpZone - S / 2 - gap
	rowY = math.max(rowY, S * 1.5 + gap + margin)
	local rightX = vp.X - margin - S / 2
	if slot == "blue" then
		return Vector2.new(rightX, rowY)
	elseif slot == "yellow" then
		return Vector2.new(rightX - S - gap, rowY)
	end
	local row2 = rowY - S - gap
	if slot == "flash" then
		return Vector2.new(rightX - S - gap, row2)
	elseif slot == "grab" then
		return Vector2.new(rightX - (S + gap) * 2, row2)
	end
	return Vector2.new(rightX, row2)
end

local function layoutButton(name, token)
	local btn = ContextActionService:GetButton(name)
	if not btn or token ~= buttonsToken then return end
	local cam = C()
	if not cam then return end
	local vp = cam.ViewportSize
	local S = buttonSize(vp)
	btn.AnchorPoint = Vector2.new(0.5, 0.5)
	btn.Size = UDim2.fromOffset(S, S)

	local label = btn:FindFirstChild("ActionTitle")
	if label and label:IsA("TextLabel") then
		pcall(function()
			label.TextScaled = true
			label.TextWrapped = false
			if not label:FindFirstChildOfClass("UITextSizeConstraint") then
				local limit = Instance.new("UITextSizeConstraint")
				limit.MinTextSize = 8
				limit.MaxTextSize = 14
				limit.Parent = label
			end
		end)
	end

	local target = slotCenter(SLOT_OF[name], S, vp)
	local frame = btn.Parent
	local off = frame and frame:IsA("GuiBase2d") and (target - frame.AbsolutePosition) or target
	for _ = 1, 3 do
		if token ~= buttonsToken then return end
		ContextActionService:SetPosition(name, UDim2.fromOffset(off.X, off.Y))
		task.wait()
		if not btn.Parent then return end
		local actual = btn.AbsolutePosition + btn.AbsoluteSize / 2
		local diff = target - actual
		if diff.Magnitude < 2 then break end
		off = off + diff
	end
end

local function styleButton(name, text, token)
	local btn
	for _ = 1, 60 do
		if token ~= buttonsToken then return end
		btn = ContextActionService:GetButton(name)
		if btn then break end
		task.wait(0.05)
	end
	if not btn or token ~= buttonsToken then return end
	ContextActionService:SetTitle(name, text)
	layoutButton(name, token)
end

local relayoutPending = false
local function relayoutAll(token)
	if relayoutPending then return end
	relayoutPending = true
	task.delay(0.15, function()
		relayoutPending = false
		if token ~= buttonsToken or not buttonsBound then return end
		for name in pairs(SLOT_OF) do
			task.spawn(function() pcall(layoutButton, name, token) end)
		end
	end)
end

local function watchScreen(token)
	for _, c in ipairs(buttonConns) do pcall(function() c:Disconnect() end) end
	buttonConns = {}
	local function hook(cam)
		if not cam then return end
		buttonConns[#buttonConns + 1] = cam:GetPropertyChangedSignal("ViewportSize"):Connect(function() relayoutAll(token) end)
	end
	hook(C())
	buttonConns[#buttonConns + 1] = workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		hook(C())
		relayoutAll(token)
	end)
end

local function unbindButtons()
	if not buttonsBound then return end
	buttonsBound = false
	buttonsToken += 1
	for _, c in ipairs(buttonConns) do pcall(function() c:Disconnect() end) end
	buttonConns = {}
	for _, n in ipairs({ ACT_YELLOW, ACT_BLUE, ACT_REMOVE, ACT_FLASH, ACT_GRAB }) do
		pcall(function() ContextActionService:UnbindAction(n) end)
	end
end

local function setGrabTitle()
	if not buttonsBound then return end
	pcall(function() ContextActionService:SetTitle(ACT_GRAB, holding and "Drop" or "Grab") end)
end

local function toggleFlash()
	if gun and not holding then
		gun.click:Play()
		gun.light.Enabled = not gun.light.Enabled
	end
end

local function bindButtons()
	if buttonsBound then return end
	buttonsBound = true
	buttonsToken += 1
	local token = buttonsToken

	local function act(fn)
		return function(_, state)
			if state == Enum.UserInputState.Begin then fn() end
			return Enum.ContextActionResult.Sink
		end
	end
	ContextActionService:BindAction(ACT_YELLOW, act(function() shoot("yellow") end), true)
	ContextActionService:BindAction(ACT_BLUE, act(function() shoot("blue") end), true)
	ContextActionService:BindAction(ACT_REMOVE, act(function() clearPortals() end), true)
	ContextActionService:BindAction(ACT_FLASH, act(function() toggleFlash() end), true)
	ContextActionService:BindAction(ACT_GRAB, act(function()
		if holding then releaseGrab() else startGrab(true) end
	end), true)

	watchScreen(token)
	for _, d in ipairs({
		{ ACT_YELLOW, "Yellow" },
		{ ACT_BLUE, "Blue" },
		{ ACT_REMOVE, "Remove" },
		{ ACT_FLASH, "Flash" },
		{ ACT_GRAB, "Grab" },
	}) do
		task.spawn(function()
			local ok, err = pcall(styleButton, d[1], d[2], token)
			if not ok then warn("[PortalGun] button style: " .. tostring(err)) end
		end)
	end
end

