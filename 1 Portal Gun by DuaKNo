local function ownsPart(root)
	if isnetworkowner then
		local ok, r = pcall(isnetworkowner, root)
		if ok then return r end
	end
	return true
end

local function partTriggers(P, root)
	local pcf = P.part.CFrame
	local lc = pcf:PointToObjectSpace(root.Position)
	if math.abs(lc.X) >= PW / 2 or math.abs(lc.Y) >= PH / 2 then return false end
	local n = pcf.LookVector
	local r, sz = root.CFrame, root.Size
	local ext = (math.abs(r.RightVector:Dot(n)) * sz.X + math.abs(r.UpVector:Dot(n)) * sz.Y + math.abs(r.LookVector:Dot(n)) * sz.Z) / 2
	local d = -lc.Z
	if d < -0.5 then return false end
	local vn = root.AssemblyLinearVelocity:Dot(n)
	if n.Y > 0.7 then
		return d < ext + 2.6
	elseif n.Y < -0.7 then
		return d < ext + 2.6 and vn < -1
	end
	return d < ext + 1.4 and vn < -1.5
end

local function teleportPart(P, Q, root)
	local pcf, qcf = P.part.CFrame, Q.part.CFrame
	local lcf = pcf:ToObjectSpace(root.CFrame)
	local qn = qcf.LookVector
	local qVert = math.abs(qn.Y) > 0.7
	local ext = math.max(root.Size.Magnitude / 2, 1)
	local push = ext + (qVert and 1.2 or 0.8)
	local ly = lcf.Position.Y
	if not qVert then ly = math.clamp(ly, -2, 2) end
	local newCF = qcf * ROT * CFrame.new(lcf.Position.X, ly, push) * (lcf - lcf.Position)

	local model = root:FindFirstAncestorOfClass("Model")
	local hum = model and model:FindFirstChildOfClass("Humanoid")
	if hum then
		local lk = newCF.LookVector
		local flat = Vector3.new(lk.X, 0, lk.Z)
		if flat.Magnitude < 0.2 then
			local ol = root.CFrame.LookVector
			flat = Vector3.new(ol.X, 0, ol.Z)
		end
		if flat.Magnitude < 0.05 then flat = Vector3.new(0, 0, -1) end
		newCF = CFrame.lookAt(newCF.Position, newCF.Position + flat.Unit)
	end

	if qn.Y > -0.7 then
		local rp = RaycastParams.new()
		rp.FilterType = Enum.RaycastFilterType.Exclude
		rp.FilterDescendantsInstances = { fxFolder, model or root }
		local pos = newCF.Position
		local g = workspace:Raycast(pos + Vector3.new(0, 2, 0), Vector3.new(0, -10, 0), rp)
		if g and pos.Y - ext < g.Position.Y then
			newCF = newCF + Vector3.new(0, (g.Position.Y + ext) - pos.Y, 0)
		end
	end

	local v = root.AssemblyLinearVelocity
	local nv = qcf:VectorToWorldSpace(ROT:VectorToWorldSpace(pcf:VectorToObjectSpace(v)))
	local out = nv:Dot(qn)
	local minOut = qVert and 10 or 8
	if out < minOut then nv = nv + qn * (minOut - out) end
	if nv.Magnitude > MAX_SPEED then nv = nv.Unit * MAX_SPEED end

	root.CFrame = newCF
	root.AssemblyLinearVelocity = nv
	root.AssemblyAngularVelocity = Vector3.zero
end

local objOP = OverlapParams.new()
objOP.FilterType = Enum.RaycastFilterType.Exclude
local objLock = setmetatable({}, { __mode = "k" })
local objAcc, fxAcc = 0, 0

track(RunService.Heartbeat:Connect(function(dt)
	if portals.blue and portals.yellow then claimNetwork() end
	objAcc += dt
	fxAcc += dt
	if objAcc < 0.05 then return end
	objAcc = 0
	local b, y = portals.blue, portals.yellow
	if not (b and y) then return end

	for root, L in pairs(objLock) do
		if not root.Parent or not L.part.Parent then
			objLock[root] = nil
		else
			local lc = L.part.CFrame:PointToObjectSpace(root.Position)
			local vertical = math.abs(L.part.CFrame.LookVector.Y) > 0.7
			if math.abs(lc.X) > PW / 2 + 0.8 or math.abs(lc.Y) > PH / 2 + 0.8
				or -lc.Z > (vertical and 6 or 4) or lc.Z > 1 then
				objLock[root] = nil
			end
		end
	end

	local ex = { fxFolder }
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl.Character then ex[#ex + 1] = pl.Character end
	end
	objOP.FilterDescendantsInstances = ex

	local seen, moved = {}, 0
	for _, pair in ipairs({ { b, y }, { y, b } }) do
		local P, Q = pair[1], pair[2]
		local ok, parts = pcall(function()
			return workspace:GetPartBoundsInBox(P.part.CFrame * CFrame.new(0, 0, -2.8), Vector3.new(PW + 1, PH + 1, 6), objOP)
		end)
		if ok then
			for _, p in ipairs(parts) do
				if moved >= 6 then break end
				if not p:IsA("Terrain") and not p.Anchored then
					local root = p.AssemblyRootPart
					if root and not root.Anchored and not seen[root] then
						seen[root] = true
						local lock = objLock[root]
						if not (lock and lock == P) and partTriggers(P, root) and ownsPart(root) then
							local okT = pcall(teleportPart, P, Q, root)
							if okT then
								objLock[root] = Q
								moved += 1
								if fxAcc > 0.2 then
									fxAcc = 0
									ripple(P)
									ripple(Q)
								end
							end
						end
					end
				end
			end
		end
	end
end))

local ACT_YELLOW, ACT_BLUE, ACT_REMOVE = "PortalGun_Yellow", "PortalGun_Blue", "PortalGun_Remove"
