local function otherOf(key) return key == "blue" and portals.yellow or portals.blue end

local function darkOf(col) return col:Lerp(Color3.new(0, 0, 0), 0.9) end

local charCache = setmetatable({}, { __mode = "k" })
local function isCharacterPart(inst)
	local cached = charCache[inst]
	if cached ~= nil then return cached end
	local result = false
	local m = inst:FindFirstAncestorOfClass("Model")
	while m do
		if m:FindFirstChildOfClass("Humanoid") then result = true break end
		m = m:FindFirstAncestorOfClass("Model")
	end
	charCache[inst] = result
	return result
end

local function relink()
	local both = portals.blue and portals.yellow
	for key, P in pairs(portals) do
		P.inner.BrickColor = BrickColor.new(both and "Really black" or COLORS[key].brick)
	end
	if hud then hud() end
end

local function resetGunColors()
	if gun and gun.cyl1 and gun.cyl1.Parent then
		gun.cyl1.Material = Enum.Material.SmoothPlastic
		gun.cyl1.Color = Color3.fromRGB(50, 50, 50)
		gun.cyl2.BrickColor = BrickColor.new("Really black")
